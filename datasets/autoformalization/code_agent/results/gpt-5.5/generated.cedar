@id("cag-018-credential-hunting-websearch")
@source("policy.md#CAG-018")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "WebSearch" && context has parameters && context.parameters has query && (context.parameters.query like "*password*dump*" || context.parameters.query like "*Password*Dump*" || context.parameters.query like "*Password*dump*" || context.parameters.query like "*password*Dump*" || context.parameters.query like "*PASSWORD*DUMP*" || context.parameters.query like "*leaked*credential*" || context.parameters.query like "*Leaked*Credential*" || context.parameters.query like "*Leaked*credential*" || context.parameters.query like "*leaked*Credential*" || context.parameters.query like "*Leaked credentials*" || context.parameters.query like "*leaked credentials*" || context.parameters.query like "*LEAKED CREDENTIALS*" || context.parameters.query like "*LEAKED*CREDENTIAL*" || context.parameters.query like "*credential*leak*" || context.parameters.query like "*Credential*Leak*" || context.parameters.query like "*Credential leak*" || context.parameters.query like "*credentials leak*" || context.parameters.query like "*leaked*creds*" || context.parameters.query like "*Leaked*Creds*" || context.parameters.query like "*Leaked creds*" || context.parameters.query like "*leaked creds*" || context.parameters.query like "*exposed*API*key*" || context.parameters.query like "*exposed*API*Key*" || context.parameters.query like "*Exposed*API*Key*" || context.parameters.query like "*Exposed API Key*" || context.parameters.query like "*exposed API key*" || context.parameters.query like "*EXPOSED*API*KEY*" || context.parameters.query like "*exposed*api*key*" || context.parameters.query like "*exposed*API_KEY*" || context.parameters.query like "*Exposed*API_KEY*" || context.parameters.query like "*API*key*exposed*" || context.parameters.query like "*api*key*exposed*") };

@id("cag-019-private-key-header-output")
@source("policy.md#CAG-019")
forbid(principal, action == coding_agent::Action::"ToolOutput", resource) when { context.content like "*-----BEGIN*PRIVATE KEY-----*" || context.content like "*-----BEGIN*RSA PRIVATE KEY-----*" || context.content like "*-----BEGIN*DSA PRIVATE KEY-----*" || context.content like "*-----BEGIN*EC PRIVATE KEY-----*" || context.content like "*-----BEGIN*OPENSSH PRIVATE KEY-----*" };

@id("cag-020-cloud-secret-output")
@source("policy.md#CAG-020")
forbid(principal, action == coding_agent::Action::"ToolOutput", resource) when { context.content like "*AWS_SECRET_ACCESS_KEY*" || context.content like "*SECRET_TOKEN=*" || context.content like "*SECRET_TOKEN =*" };