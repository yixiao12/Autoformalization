@id("cag-015-command-timeout")
@source("policy.md#CAG-015")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Bash" && context has parameters && context.parameters has timeout && context.parameters.timeout > 300000 };

@id("cag-016-secure-web-transport")
@source("policy.md#CAG-016")
