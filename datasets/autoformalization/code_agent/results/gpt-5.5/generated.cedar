@id("default-prompt-permit")
@source("default")
permit(principal, action == coding_agent::Action::"Prompt", resource);

@id("default-pretooluse-permit")
@source("default")
permit(principal, action == coding_agent::Action::"PreToolUse", resource);

@id("default-tooloutput-permit")
@source("default")
permit(principal, action == coding_agent::Action::"ToolOutput", resource);

@id("cag-001-sensitive-write-path")
@source("policy.md#CAG-001")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Write" && context has parameters && context.parameters has file_path && (context.parameters.file_path like "*.env*" || context.parameters.file_path like "*credentials*" || context.parameters.file_path like "*secrets*") };

@id("cag-002-sensitive-edit-path")
@source("policy.md#CAG-002")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Edit" && context has parameters && context.parameters has file_path && (context.parameters.file_path like "*.env*" || context.parameters.file_path like "*id_rsa" || context.parameters.file_path like "*id_rsa.*" || context.parameters.file_path like "*.pem" || context.parameters.file_path like "*.pem.*") };

@id("cag-003-git-metadata-write-edit")
@source("policy.md#CAG-003")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { (context.tool == "Write" || context.tool == "Edit") && context has parameters && context.parameters has file_path && (context.parameters.file_path like ".git/*" || context.parameters.file_path like "*/.git/*") };

@id("cag-004-sensitive-read-env-pem-aws")
@source("policy.md#CAG-004")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Read" && context has parameters && context.parameters has file_path && (context.parameters.file_path like "*.env*" || context.parameters.file_path like "*.pem" || context.parameters.file_path like "*.pem.*" || context.parameters.file_path like ".aws/credentials" || context.parameters.file_path like ".aws/credentials.*" || context.parameters.file_path like ".aws/credentials/*" || context.parameters.file_path like "*/.aws/credentials" || context.parameters.file_path like "*/.aws/credentials.*" || context.parameters.file_path like "*/.aws/credentials/*") };

@id("cag-004-sensitive-read-ssh-private-key-names")
@source("policy.md#CAG-004")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Read" && context has parameters && context.parameters has file_path && (context.parameters.file_path like "*/.ssh/id_rsa" || context.parameters.file_path like "*/.ssh/id_ed25519" || context.parameters.file_path like "*/.ssh/id_ecdsa" || context.parameters.file_path like "*/.ssh/id_dsa" || context.parameters.file_path like "*/.ssh/id_rsa-*" || context.parameters.file_path like "*/.ssh/id_ed25519-*" || context.parameters.file_path like "*/.ssh/id_ecdsa-*" || context.parameters.file_path like "*/.ssh/id_dsa-*" || context.parameters.file_path like ".ssh/id_rsa" || context.parameters.file_path like ".ssh/id_ed25519" || context.parameters.file_path like ".ssh/id_ecdsa" || context.parameters.file_path like ".ssh/id_dsa" || context.parameters.file_path like ".ssh/id_rsa-*" || context.parameters.file_path like ".ssh/id_ed25519-*" || context.parameters.file_path like ".ssh/id_ecdsa-*" || context.parameters.file_path like ".ssh/id_dsa-*") };

@id("cag-004-sensitive-read-ssh-directory-non-public")
@source("policy.md#CAG-004")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Read" && context has parameters && context.parameters has file_path && (context.parameters.file_path like "*/.ssh/*" || context.parameters.file_path like ".ssh/*") && !(context.parameters.file_path like "*.pub") && !(context.parameters.file_path like "*.pub.*") };

@id("cag-005-secret-oriented-grep")
@source("policy.md#CAG-005")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Grep" && context has parameters && context.parameters has pattern && (context.parameters.pattern like "*-----BEGIN*PRIVATE KEY-----*" || context.parameters.pattern like "*-----BEGIN*RSA PRIVATE KEY-----*" || context.parameters.pattern like "*-----BEGIN*DSA PRIVATE KEY-----*" || context.parameters.pattern like "*-----BEGIN*EC PRIVATE KEY-----*" || context.parameters.pattern like "*-----BEGIN*OPENSSH PRIVATE KEY-----*" || context.parameters.pattern like "*BEGIN*PRIVATE KEY*" || context.parameters.pattern like "*BEGIN*RSA PRIVATE KEY*" || context.parameters.pattern like "*BEGIN*DSA PRIVATE KEY*" || context.parameters.pattern like "*BEGIN*EC PRIVATE KEY*" || context.parameters.pattern like "*BEGIN*OPENSSH PRIVATE KEY*" || context.parameters.pattern like "*API_KEY*=*" || context.parameters.pattern like "*api_key*=*" || context.parameters.pattern like "*Api_Key*=*" || context.parameters.pattern like "*password*=*" || context.parameters.pattern like "*PASSWORD*=*" || context.parameters.pattern like "*Password*=*") };

@id("cag-006-sensitive-glob-directory")
@source("policy.md#CAG-006")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Glob" && context has parameters && ((context.parameters has pattern && (context.parameters.pattern == ".ssh" || context.parameters.pattern like ".ssh/*" || context.parameters.pattern like "*/.ssh/*" || context.parameters.pattern == ".aws" || context.parameters.pattern like ".aws/*" || context.parameters.pattern like "*/.aws/*" || context.parameters.pattern == ".git" || context.parameters.pattern like ".git/*" || context.parameters.pattern like "*/.git/*")) || (context.parameters has path && (context.parameters.path == ".ssh" || context.parameters.path like ".ssh/*" || context.parameters.path like "*/.ssh" || context.parameters.path like "*/.ssh/*" || context.parameters.path == ".aws" || context.parameters.path like ".aws/*" || context.parameters.path like "*/.aws" || context.parameters.path like "*/.aws/*" || context.parameters.path == ".git" || context.parameters.path like ".git/*" || context.parameters.path like "*/.git" || context.parameters.path like "*/.git/*"))) };

@id("cag-007-private-key-header-write")
@source("policy.md#CAG-007")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Write" && context has parameters && context.parameters has content && (context.parameters.content like "*-----BEGIN*PRIVATE KEY-----*" || context.parameters.content like "*-----BEGIN*RSA PRIVATE KEY-----*" || context.parameters.content like "*-----BEGIN*DSA PRIVATE KEY-----*" || context.parameters.content like "*-----BEGIN*EC PRIVATE KEY-----*" || context.parameters.content like "*-----BEGIN*OPENSSH PRIVATE KEY-----*") };

@id("cag-008-secret-insertion-edit")
@source("policy.md#CAG-008")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Edit" && context has parameters && context.parameters has new_string && (context.parameters.new_string like "*-----BEGIN*PRIVATE KEY-----*" || context.parameters.new_string like "*-----BEGIN*RSA PRIVATE KEY-----*" || context.parameters.new_string like "*-----BEGIN*DSA PRIVATE KEY-----*" || context.parameters.new_string like "*-----BEGIN*EC PRIVATE KEY-----*" || context.parameters.new_string like "*-----BEGIN*OPENSSH PRIVATE KEY-----*" || context.parameters.new_string like "*AWS_SECRET_ACCESS_KEY*" || context.parameters.new_string like "*API_KEY*=*") };

@id("cag-009-destructive-delete-root")
@source("policy.md#CAG-009")
forbid(principal, action == coding_agent::Action::"PreToolUse", resource) when { context.tool == "Bash" && context has parameters && context.parameters has command && (context.parameters.command like "rm -rf* /" || context.parameters.command like "rm -rf* / *" || context.parameters.command like "rm -fr* /" || context.parameters.command like "rm -fr* / *" || context.parameters.command like "rm -r -f* /" || context.parameters.command like "rm -r -f* / *" || context.parameters.command like "rm -f -r* /" || context.parameters.command like "rm -f -r* / *" || context.parameters.command like "rm --recursive --force* /" || context.parameters.command like "rm --recursive --force* / *" || context.parameters.command like "rm --force --recursive* /" || context.parameters.command like "rm --force --recursive* / *" || context.parameters.command like "*; rm -rf* /" || context.parameters.command like "*; rm -fr* /" || context.parameters.command like "*&& rm -rf* /" || context.parameters.command like "*&& rm -fr* /" || context.parameters.command == "rm -rf /*" || context.parameters.command == "rm -fr /*") };

