rm -fr* '$HOME'" || context.parameters.command like "rm -fr* '$HOME'/" || context.parameters.command like "rm -fr* \"${HOME}\"" || context.parameters.command like "rm -fr* \"${HOME}\"/" || context.parameters.command like "rm -fr* '${HOME}'" || context.parameters.command like "rm -fr* '${HOME}'/" || context.parameters.command like "*; rm -rf* ~" || context.parameters.command like "*; rm -fr* ~" || context.parameters.command like "*&& rm -rf* ~" || context.parameters.command like "*&& rm -fr* ~" || context.parameters.command like "*; rm -rf* ${HOME}" || context.parameters.command like "*; rm -fr* ${HOME}" || context.parameters.command like "*&& rm -rf* ${HOME}" || context.parameters.command like "*&& rm -fr* ${HOME}") };

