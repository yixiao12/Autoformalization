      "PreToolUse",
      "ToolOutput"
    ],
    "target_tools": [
      "*"
    ],
    "required_context": [],
    "severity": "medium",
    "enforceability": "unenforceable"
  },
  {
    "id": "MAB-5-6",
    "source": "policy.md§5.6",
    "effect": "forbid",
    "text": "Check for likely duplicates and confirm whether a new entry is intended.",
