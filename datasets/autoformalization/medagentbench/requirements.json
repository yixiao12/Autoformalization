      "post_observation",
      "post_medication_request",
      "post_service_request"
    ],
    "required_context": [
      "context.medical",
      "context.session"
    ],
    "severity": "critical",
    "enforceability": "requires_normalization"
  },
  {
    "id": "MAB-5-2",
    "source": "policy.md§5.2",
    "effect": "forbid",
    "text": "Verify the resource is linked to the **confirmed** patient; do not write if identity is unresolved.",
    "target_stages": [
      "PreToolUse"
    ],
    "target_tools": [
      "post_request",
      "post_observation",
      "post_medication_request",
      "post_service_request"
    ],
    "required_context": [
      "context.medical",
      "context.session"
    ],
    "severity": "critical",
    "enforceability": "requires_normalization"
  },
  {
    "id": "MAB-5-3",
    "source": "policy.md§5.3",
    "effect": "forbid",
    "text": "Do not assume/autocomplete missing required details; ask the user.",
